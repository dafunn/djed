# --- LLM gateway ---
# OpenAI-compatible endpoint. Any LiteLLM / vLLM / Ollama-compatible gateway.
KWIM_LLM_BASE_URL=http://localhost:4000/v1
# Bearer key for the gateway.
DJED_LITELLM_KEY=
# Required, no default. Model name exactly as the gateway knows it.
# `headless.py --list-models` prints what the gateway serves.
DJED_MODEL=

# --- KWIM memory (fail-soft if unset or unreachable) ---
# The KWIM service, not the LLM gateway.
KWIM_BASE_URL=http://localhost:8000
# Bearer key for KWIM.
DJED_KWIM_API_KEY=
# DJED_SESSION=maat-cli        # stable session id -> warm-start pulls prior sessions

# --- optional tuning ---
# DJED_AGENT=maat              # x-litellm-tags spend attribution
# DJED_CONTEXT_WINDOW=40000    # local model context window
# DJED_MAX_TOKENS=8000         # max output tokens
# DJED_WINDOW_MSGS=12          # recent transcript messages kept in-agent
# DJED_RECALL_K=4              # KWIM chunks retrieved per turn

# --- MCP bridge (optional) ---
# JSON array of MCP servers.
#
# Against the local podman fleet, the servers are containers on the internal
# `tools` network and are addressed by container name - not localhost, which
# resolves to the TUI container itself once it is off host networking:
# DJED_MCP_SERVERS='[{"name":"database","transport":"sse","url":"http://pg-mcp:3000/sse"},{"name":"cluster","transport":"sse","url":"http://k8s-mcp:3000/sse"},{"name":"logs","transport":"sse","url":"http://loki-mcp:3000/sse"},{"name":"forge","transport":"sse","url":"http://forgejo-mcp:3000/sse"},{"name":"repos","transport":"sse","url":"http://repo-mcp:3000/sse"},{"name":"base","transport":"sse","url":"http://base-mcp:3000/sse"}]'
#
# A server behind a bearer token takes it in `headers` - the value stays in this
# config and never reaches the model:
# DJED_MCP_SERVERS='[{"name":"base","transport":"sse","url":"http://base-mcp:3000/sse","headers":{"Authorization":"Bearer TOKEN"}}]'
#
# Other shapes:
# DJED_MCP_SERVERS='[{"name":"logs","transport":"sse","url":"http://localhost:PORT/sse"}]'
# DJED_MCP_SERVERS='[{"name":"logs","transport":"stdio","command":"python3","args":["../your-mcp-server/server.py"],"env":{"LOGS_URL":"http://localhost:PORT","LOGS_ALLOWED_NAMESPACES":"monitoring","EXPOSE_METADATA":"true"}}]'
DJED_MCP_SERVERS=
# DJED_MCP_TIMEOUT_MS=10000

# --- state ---
# Where input history is kept, so the up arrow reaches past this session. The
# sandboxed launcher sets this to a mounted path; on a workstation it defaults to
# $XDG_STATE_HOME/djed/history (~/.local/state/djed/history).
# DJED_HISTORY_FILE=
