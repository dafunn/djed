# Djed sandbox image: python:3.14-slim + a pinned, checksum-verified kubectl.
# The container is the OS boundary for `run_command`. No kubeconfig is mounted;
# kubectl here is unauthenticated.
#
#   podman build -t djed-sandbox -f sandbox/Dockerfile.python .
FROM docker.io/library/python:3.14-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.22@sha256:f513a91fc62fe7c17567eee97230dd198e43edb8a9fbecca843714a4358fe1bc /uv /uvx /bin/

ARG KUBECTL_VERSION=v1.34.2

# git is for the build agent: provisioning clones and branches, a build run
# commits. It is the only toolchain added; a project's own dependencies go in
# the venv provisioning builds.
# curl retries, with a 15s connect timeout instead of the 300s default.
ARG CURL_RETRY="--connect-timeout 15 --retry 5 --retry-all-errors --retry-delay 3"
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl jq git; \
    rm -rf /var/lib/apt/lists/*; \
    arch="$(dpkg --print-architecture)"; \
    base="https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${arch}"; \
    curl -fsSL ${CURL_RETRY} -o /usr/local/bin/kubectl "${base}/kubectl"; \
    curl -fsSL ${CURL_RETRY} -o /tmp/kubectl.sha256 "${base}/kubectl.sha256"; \
    printf '%s  %s\n' "$(cat /tmp/kubectl.sha256)" /usr/local/bin/kubectl | sha256sum -c -; \
    rm -f /tmp/kubectl.sha256; \
    chmod +x /usr/local/bin/kubectl; \
    kubectl version --client

# The package source is copied because a pyproject build needs it; run_djed.sh
# bind-mounts the live checkout over it, so only dependency changes need a
# rebuild. The locked runtime dependencies and djed itself install into
# /opt/venv.
COPY py/pyproject.toml py/uv.lock /tmp/build/
COPY py/djed /tmp/build/djed
RUN set -eux; \
    cd /tmp/build; \
    UV_PROJECT_ENVIRONMENT=/opt/venv uv sync --frozen --no-editable; \
    rm -rf /tmp/build; \
    /opt/venv/bin/python -c "import pydantic_ai, textual, djed; print('deps ok')"

# tiktoken downloads its BPE table on first use and caches it under
# TIKTOKEN_CACHE_DIR, keyed by sha1 of the source URL. The agent's network has
# no route to it, so fetch it here and assert the cache file landed.
ENV TIKTOKEN_CACHE_DIR=/opt/tiktoken
RUN set -eux; \
    mkdir -p "$TIKTOKEN_CACHE_DIR"; \
    /opt/venv/bin/python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')"; \
    test -s "$TIKTOKEN_CACHE_DIR/9b5ad71b2ce5302211f9c61530b329a4922fc6a4"

ENV PATH="/opt/venv/bin:${PATH}"
WORKDIR /app/py
